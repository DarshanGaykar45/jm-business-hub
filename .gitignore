# Root .gitignore for JM Business Hub

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Backend storage - private documents must never be committed
/backend/storage/
backend/storage/private-documents/*
!backend/storage/private-documents/.gitkeep

# SQLite database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
coverage/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

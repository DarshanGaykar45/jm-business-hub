# JM BUSINESS HUB — Backend Environment Configuration Example
# Copy this file to .env and configure real random secret values for development / production.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite database for easy local development. For PostgreSQL, use:
# postgresql://USER:PASSWORD@localhost:5432/jm_business_hub?schema=public
DATABASE_URL="file:./dev.db"

# Security secrets (MUST be at least 32 characters long and not set to example values)
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Private Storage Directory (defaults to storage/private-documents)
STORAGE_DIR=storage/private-documents
